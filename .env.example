# Healthy Eating AI - environment template. Copy to `.env` (git-ignored) at the
# repository root for LOCAL development/test only. Never commit real values.
#
# Environment model (see docs/deployment.md):
#   development  NODE_ENV unset/"development" - reads this .env, convenient defaults
#   test         NODE_ENV="test" (set by Playwright) - AI_PROVIDER=mock forced by the suites
#   staging      NODE_ENV="production" with staging values (real env vars, no .env file)
#   production   NODE_ENV="production" with production values (real env vars, no .env file)
# In production mode the API does NOT read this file - set real environment
# variables on the platform instead, and it refuses to start if they are invalid.

# ---- API --------------------------------------------------------------------
# development | test | production (staging also uses "production")
NODE_ENV=development

PORT=4000

# PostgreSQL connection string. REQUIRED in production. Never exposed to the
# Web app. For managed databases that need TLS append ?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/healthy_eating

# Signs/verifies the session JWT (Web cookie and Mobile Bearer token alike).
# REQUIRED in production, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Blank in development = a random per-process secret (sessions reset on restart).
JWT_SECRET=

# The Web app's own origin. CORS echoes exactly this origin (never "*") so the
# credentialed session cookie is accepted. REQUIRED in production and must be
# https://... there (scheme + host [+ port], no path, no trailing slash).
WEB_ORIGIN=http://localhost:5173

# "mock" (default): deterministic offline stand-in, used by every automated
# suite, needs no key. "openai": real vision provider. Anything else fails
# startup - there is never a silent fallback to mock.
AI_PROVIDER=mock

# REQUIRED only when AI_PROVIDER=openai. Server-side secret - never VITE_-prefix it.
OPENAI_API_KEY=

# Optional. Defaults to a current vision-capable model (apps/api/src/config/env.ts).
OPENAI_MODEL=

# ---- Web (build-time, PUBLIC values only) ----------------------------------
# Only VITE_-prefixed variables ever reach the browser bundle. A production
# Web build REQUIRES this (https:// in production) and fails otherwise.
VITE_API_BASE_URL=http://localhost:4000

# Mobile has its own file: apps/mobile/.env (see apps/mobile/.env.example).

# Optional: fatal|error|warn|info|debug|trace|silent (default info)
# LOG_LEVEL=info

# Optional: expose GET /metrics (Prometheus format). Default false -> /metrics is a 404.
# The endpoint is unauthenticated: restrict it at the network level.
# METRICS_ENABLED=false

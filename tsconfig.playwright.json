{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "@playwright/test"
    ],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.api.config.ts",
    "playwright.e2e.config.ts",

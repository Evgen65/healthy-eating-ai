{
  "name": "healthy-eating-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Healthy Eating AI - Web + Mobile nutrition tracking monorepo (Milestone 18: Mobile Dashboard + Meals + History)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:tests && npm run typecheck:mobile-tests",
    "typecheck:tests": "tsc -p tsconfig.playwright.json --noEmit",
    "typecheck:mobile-tests": "tsc -p tests/mobile/tsconfig.json --noEmit",
    "typecheck:mobile": "npm run tsc:check --workspace=apps/mobile",
    "test:web": "playwright test",
    "test:web:headed": "playwright test --headed",
    "test:web:ui": "playwright test --ui",
    "test:web:report": "playwright show-report",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:api:report": "playwright show-report playwright-report-api",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.e2e.config.ts --headed",
    "test:e2e:report": "playwright show-report playwright-report-e2e",
    "test:mobile": "wdio run wdio.mobile.conf.ts",
    "test:mobile:doctor": "tsx tests/mobile/doctor.ts",
    "mobile:api": "cross-env AI_PROVIDER=mock npm run dev:api",
    "mobile:metro": "npm run start:emulator --workspace=apps/mobile",
    "mobile:appium": "appium --address 127.0.0.1 --port 4723 --log-filters tests/mobile/appium-log-filters.json",
    "test:all": "npm run test:web && npm run test:api",
    "db:migrate": "npm run migrate:up --workspace=apps/api",
    "db:rollback": "npm run migrate:down --workspace=apps/api",
    "db:status": "npm run migrate:status --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "preview:web": "npm run preview --workspace=apps/web",
    "smoke:prod": "node scripts/smoke-production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.23.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "appium": "3.8.0",
    "appium-uiautomator2-driver": "8.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "10.1.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "webdriverio": "9.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}

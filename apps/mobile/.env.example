# Copy this file to apps/mobile/.env and adjust EXPO_PUBLIC_API_BASE_URL for
# whichever target you're running against. Unlike the Web app (which reads
# the single .env at the repository root via Vite's envDir), Expo only
# inlines EXPO_PUBLIC_-prefixed variables from a .env file inside THIS
# directory (apps/mobile/.env) - see src/config/env.ts for why, and for the
# full explanation of each value below.
#
# Anything EXPO_PUBLIC_-prefixed ships inside the built app bundle and is
# readable by anyone who has the app - never put secrets here.

# Desktop/Expo Web (npm run web) and iOS Simulator - the default below.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Android emulator - uncomment instead of the line above. The emulator maps
# 10.0.2.2 to the host development machine's localhost; plain "localhost"
# inside the emulator means the emulator itself, not your machine.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Physical phone (Expo Go or a dev build) - uncomment instead, replacing
# 192.168.1.23 with your development machine's actual LAN IP (`ipconfig` on
# Windows). The phone must be on the same Wi-Fi/network as that machine, and
# Windows Firewall may need to allow inbound connections on this port.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:4000

# Production / staging release builds (a later release milestone): use the
# public HTTPS URL of the API. A release bundle (__DEV__ === false) refuses to
# start with a non-https URL (src/config/env.ts), so auth tokens never travel
# over plain HTTP outside development.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
